{
  "$comment": "Generated by python -m scripts.export_research_schema. Candidate contract only; no authority.",
  "$id": "urn:claimbranch:research-command:v20",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "contribution_origin": {
          "enum": [
            "human",
            "ai",
            "mixed",
            "unknown"
          ]
        },
        "created_at": {
          "format": "date-time",
          "maxLength": 20,
          "minLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "evidence_watermark": {
          "maximum": 1024,
          "minimum": 0,
          "type": "integer"
        },
        "expected_heads": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "main": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                }
              },
              "required": [
                "main"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "alternative": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                },
                "main": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                }
              },
              "required": [
                "main",
                "alternative"
              ],
              "type": "object"
            }
          ]
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "operation_type": {
          "const": "acknowledge-wording-warning"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "anchor_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "claim_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "expected_anchor_digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "expected_policy_digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "phrase": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string",
              "x-utf8-maxBytes": 16384
            },
            "rationale": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string",
              "x-utf8-maxBytes": 16384
            },
            "rule": {
              "enum": [
                "banned-phrase",
                "caveat-text-not-found"
              ]
            }
          },
          "required": [
            "id",
            "claim_id",
            "anchor_id",
            "expected_policy_digest",
            "expected_anchor_digest",
            "rule",
            "phrase",
            "rationale"
          ],
          "type": "object"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "schema_version": {
          "const": 20,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "id",
        "project_id",
        "episode_id",
        "created_at",
        "operation_type",
        "expected_heads",
        "contribution_origin",
        "evidence_watermark",
        "payload"
      ],
      "type": "object"
    }
  ],
  "title": "ClaimBranch portable research-history command v20"
}
