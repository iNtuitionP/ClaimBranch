{
  "$comment": "Generated by python -m scripts.export_research_schema. Unverified candidate only. Runtime requires canonical NFC UTF-8 bytes, intact sealed cause/debt identity, current displayed context and live review timing. Schema validation does not verify source authority, topic derivation, human presence or receipt consumption.",
  "$id": "urn:claimbranch:understanding-closure-review:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_verified": {
      "const": false
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "cause_operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "cause_review_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "debt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "displayed_context_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "evidence_watermark": {
          "maximum": 32,
          "minimum": 0,
          "type": "integer"
        },
        "expected_head": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "topics_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "topics_rule_version": {
          "const": "claimbranch.understanding-topics/v1"
        }
      },
      "required": [
        "project_id",
        "episode_id",
        "debt_id",
        "cause_operation_id",
        "cause_review_digest",
        "expected_head",
        "evidence_watermark",
        "topics_rule_version",
        "topics_digest",
        "displayed_context_digest"
      ],
      "type": "object"
    },
    "expires_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "rationale": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string",
      "x-utf8-maxBytes": 16384
    },
    "rule_version": {
      "const": "understanding-closure-v1"
    },
    "schema": {
      "const": "claimbranch.understanding-closure-review/v1"
    },
    "sealed_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session_nonce": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "rule_version",
    "context",
    "operation_id",
    "rationale",
    "session_nonce",
    "sealed_at",
    "expires_at",
    "authorization_verified"
  ],
  "type": "object"
}
