{
  "$comment": "Generated by python -m scripts.export_research_schema. Candidate contract only; no authority.",
  "$id": "urn:claimbranch:research-command:v8",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "maxLength": 20,
          "minLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "evidence_watermark": {
          "maximum": 1024,
          "minimum": 0,
          "type": "integer"
        },
        "expected_heads": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "main": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                }
              },
              "required": [
                "main"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "alternative": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                },
                "main": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                }
              },
              "required": [
                "main",
                "alternative"
              ],
              "type": "object"
            }
          ]
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "operation_type": {
          "const": "record-co-report"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "answers": {
              "items": {
                "maxLength": 16384,
                "minLength": 1,
                "type": "string",
                "x-utf8-maxBytes": 16384
              },
              "maxItems": 3,
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "candidates": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "claim_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                    "type": "string"
                  },
                  "edge_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                    "type": "string"
                  },
                  "edge_type": {
                    "enum": [
                      "supports",
                      "challenges",
                      "qualifies"
                    ]
                  },
                  "id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                    "type": "string"
                  },
                  "observation_ids": {
                    "items": {
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "type": "string"
                    },
                    "maxItems": 256,
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "origin": {
                    "enum": [
                      "human",
                      "ai",
                      "mixed",
                      "unknown"
                    ]
                  },
                  "scope": {
                    "maxLength": 16384,
                    "minLength": 1,
                    "type": "string",
                    "x-utf8-maxBytes": 16384
                  },
                  "source_id": {
                    "oneOf": [
                      {
                        "maxLength": 128,
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "statement": {
                    "maxLength": 16384,
                    "minLength": 1,
                    "type": "string",
                    "x-utf8-maxBytes": 16384
                  }
                },
                "required": [
                  "id",
                  "statement",
                  "scope",
                  "observation_ids",
                  "claim_id",
                  "edge_id",
                  "edge_type",
                  "source_id",
                  "origin"
                ],
                "type": "object"
              },
              "maxItems": 4,
              "minItems": 2,
              "type": "array",
              "uniqueItems": false
            },
            "companion_ids": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "context_digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "disposition": {
              "enum": [
                "not-required",
                "answered",
                "deferred"
              ]
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "judgment": {
              "additionalProperties": false,
              "properties": {
                "episode_id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                },
                "history": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "contributor": {
                        "enum": [
                          "human",
                          "ai"
                        ]
                      },
                      "parent_digest": {
                        "oneOf": [
                          {
                            "maxLength": 64,
                            "minLength": 64,
                            "pattern": "^[0-9a-f]{64}$",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "proposal_id": {
                        "oneOf": [
                          {
                            "maxLength": 128,
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "rationale": {
                        "oneOf": [
                          {
                            "maxLength": 16384,
                            "minLength": 1,
                            "type": "string",
                            "x-utf8-maxBytes": 16384
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "text": {
                        "maxLength": 16384,
                        "minLength": 1,
                        "type": "string",
                        "x-utf8-maxBytes": 16384
                      },
                      "trace_digest": {
                        "oneOf": [
                          {
                            "maxLength": 64,
                            "minLength": 64,
                            "pattern": "^[0-9a-f]{64}$",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "contributor",
                      "text",
                      "rationale",
                      "proposal_id",
                      "trace_digest",
                      "parent_digest"
                    ],
                    "type": "object"
                  },
                  "maxItems": 8,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": false
                },
                "project_id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string"
                },
                "rationale": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "type": "string",
                  "x-utf8-maxBytes": 16384
                },
                "text": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "type": "string",
                  "x-utf8-maxBytes": 16384
                }
              },
              "required": [
                "project_id",
                "episode_id",
                "text",
                "rationale",
                "history"
              ],
              "type": "object"
            },
            "selected_ids": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "candidates",
            "selected_ids",
            "companion_ids",
            "context_digest",
            "judgment",
            "disposition",
            "answers"
          ],
          "type": "object"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "schema_version": {
          "const": 8,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "id",
        "project_id",
        "episode_id",
        "created_at",
        "operation_type",
        "expected_heads",
        "evidence_watermark",
        "payload"
      ],
      "type": "object"
    }
  ],
  "title": "ClaimBranch portable research-history command v8"
}
