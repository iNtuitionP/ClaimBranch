{
  "$id": "urn:claimbranch:paper-seed:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "claim_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "claim_statement": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string",
      "x-utf8-maxBytes": 16384
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "paper_title": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string",
      "x-utf8-maxBytes": 16384
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "episode_id",
    "paper_title",
    "claim_id",
    "claim_statement",
    "anchor_id"
  ],
  "type": "object"
}
