{
  "$comment": "Generated by scripts/export_research_schema.py; explicit selection, no authority or transport.",
  "$id": "urn:claimbranch:paper-context-request:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "compare-evidence",
        "critique-interpretation",
        "plan-experiment",
        "draft-manuscript"
      ]
    },
    "ref": {
      "enum": [
        "main",
        "alternative"
      ]
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "scientific_edge_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "selections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fields": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "record_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "fields"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array",
      "uniqueItems": false
    },
    "view_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "episode_id",
    "ref",
    "view_digest",
    "purpose",
    "selections",
    "scientific_edge_ids"
  ],
  "type": "object"
}
